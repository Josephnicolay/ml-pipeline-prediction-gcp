# Copy this file to .env.deploy and replace values

# Data preload
SOURCE_PROJECT_ID=source-mlops
SOURCE_DATASET_ID=bq_housing_source
SOURCE_TABLE_ID=input_table

# Pipeline compilation/upload
EMAIL=user@example.com
GCS_BUCKET=process-mlops-artifacts

# Container image / Artifact Registry
PROCESS_PROJECT_ID=process-mlops
REGION=us-central1
CLOUD_RUN_REPO=cloud-run-repo
IMAGE_NAME=pipeline-job-runner
IMAGE_TAG=latest

# Cloud Run Job
JOB_NAME=house-price-pipeline-job
CLOUD_RUN_SERVICE_ACCOUNT=cloud-run@process-mlops.iam.gserviceaccount.com
JOB_ENV_FILE=.env

# Cloud Scheduler
SCHEDULER_LOCATION=us-central1
SCHEDULER_NAME=house-price-pipeline-job
SCHEDULER_SCHEDULE="0 8 * * *"
SCHEDULER_TIME_ZONE=America/Lima
